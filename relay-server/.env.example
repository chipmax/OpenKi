# Bắt buộc: shared secret giữa loimo và relay. Sinh bằng: openssl rand -hex 32
LOIMO_RELAY_TOKEN=replace-with-openssl-rand-hex-32

# Bắt buộc: danh sách host upstream được phép, phân tách bằng dấu phẩy.
# Rỗng = từ chối tất cả. Ví dụ: opencode.ai
LOIMO_RELAY_HOSTS=opencode.ai

# Nhãn vùng trả về trong header X-Relay-Region. Trên Vercel có thể bỏ trống để
# dùng VERCEL_REGION; mặc định "local".
LOIMO_RELAY_REGION=vn-sin1

# Chỉ đặt 1 cho thử nghiệm nội bộ. Production bắt buộc https.
LOIMO_RELAY_ALLOW_HTTP=0

# Giới hạn body request (byte). Mặc định 67108864 = 64 MiB.
LOIMO_RELAY_MAX_BODY_BYTES=67108864

# Thời gian tối đa cho một request upstream (mili giây). Mặc định 300000.
LOIMO_RELAY_TIMEOUT_MS=300000

# Chỉ dùng khi chạy local/Docker. Vercel bỏ qua hai biến này.
PORT=8789
HOST=0.0.0.0
