[Unit]
Description=OpenKi gateway (headless, VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openki
Group=openki
Environment=HOME=/var/lib/openki
Environment=OPENKI_HEADLESS=1
Environment=OPENKI_HOME=/var/lib/openki
WorkingDirectory=/var/lib/openki
ExecStart=/opt/openki/openki --no-inject
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

StateDirectory=openki
StateDirectoryMode=0750

# Hardening cơ bản: filesystem chỉ đọc trừ thư mục dữ liệu.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openki
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# sing-box sidecar needs netlink for its network stack.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
