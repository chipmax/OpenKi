[Unit]
Description=Lối Mở gateway (headless, VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loimo
Group=loimo
Environment=HOME=/var/lib/loimo
Environment=LOIMO_HEADLESS=1
Environment=LOIMO_HOME=/var/lib/loimo
WorkingDirectory=/var/lib/loimo
ExecStart=/opt/loimo/loimo --no-inject
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

StateDirectory=loimo
StateDirectoryMode=0750

# Hardening cơ bản: filesystem chỉ đọc trừ thư mục dữ liệu.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/loimo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
