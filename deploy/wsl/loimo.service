[Unit]
Description=Lối Mở gateway (WSL headless)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
Environment=HOME=/home/admin
Environment=LOIMO_HEADLESS=1
Environment=LOIMO_HOME=/home/admin/.config/loimo
WorkingDirectory=/home/admin
ExecStart=/usr/local/bin/loimo --inject-scope=wsl
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

# Hardening cơ bản. Agent config nằm rải trong HOME nên HOME phải ghi được;
# phần còn lại của hệ thống chỉ đọc.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/admin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
