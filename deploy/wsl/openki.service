[Unit]
Description=OpenKi gateway (WSL headless)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
Environment=HOME=/home/admin
Environment=OPENKI_HEADLESS=1
Environment=OPENKI_HOME=/home/admin/.config/openki
WorkingDirectory=/home/admin
ExecStart=/usr/local/bin/openki --inject-scope=wsl
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077

# Hardening cơ bản. Agent config nằm rải trong HOME nên HOME phải ghi được;
# phần còn lại của hệ thống chỉ đọc.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/admin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# sing-box sidecar needs netlink for its network stack.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
